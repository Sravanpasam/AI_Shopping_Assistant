# Copy this file to .env and fill in your own values. Never commit .env.

# Which provider the agent uses: "gemini" or "groq".
LLM_PROVIDER=gemini

# ---- Groq (fast, free tier, OpenAI-compatible; supports function calling) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated backups when the primary is retired or out of daily quota.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# ---- Google Gemini ----
# Google AI Studio API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=your-api-key-here

# Model used by the LLM agent. Leave as a current Gemini model name.
# Use scripts/list_models.py to see which models your key can use.
GEMINI_MODEL=gemini-3.8-flash

# Backup models, tried in order when the primary is retired ("model not found")
# or hits its per-day quota. Comma-separated; leave blank to disable. Pick
# flash-class models that support function calling (scripts/list_models.py).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-2.5-flash

# Maximum LLM requests per model per day. Kept conservative so the app stops
# calling a model before it hits the provider's free-tier daily limit.
LLM_DAILY_BUDGET=20

# Maximum LLM requests per minute (free tier is limited).
LLM_MAX_REQUESTS_PER_MINUTE=10

# Opt-in response cache for evaluation runs: when set to 1, identical
# (message, context, history) requests are answered from data/llm_cache.json
# instead of calling the model again. Leave 0 for normal use.
LLM_CACHE=0
# LLM_CACHE_PATH=data/llm_cache.json

# Per-request timeout in seconds.
LLM_REQUEST_TIMEOUT=60

# Sampling temperature (low keeps answers grounded and consistent).
LLM_TEMPERATURE=0.2
